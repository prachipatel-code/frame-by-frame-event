# ===========================================
# Frame By Frame Event Platform – Environment Variables
# ===========================================
# Copy these into Vercel → Project → Settings → Environment Variables
# Never commit real secrets to GitHub.

# ---- Required ----

# Neon PostgreSQL connection string (from Neon dashboard)
DATABASE_URL="postgresql://USER:PASSWORD@HOST/neondb?sslmode=require"

# Optional: unpooled connection for migrations (Neon provides this)
# DATABASE_URL_UNPOOLED="postgresql://..."

# Auth.js secret – generate a long random string (e.g. openssl rand -base64 32)
AUTH_SECRET="replace-with-a-long-random-secret"

# Public URL of your deployed site (no trailing slash)
NEXT_PUBLIC_APP_URL="https://your-project.vercel.app"

# ---- Email (Resend) ----
# Get key from https://resend.com
RESEND_API_KEY="re_xxxxxxxx"
RESEND_FROM_EMAIL="onboarding@resend.dev"
RESEND_FROM_NAME="Frame By Frame 2027"

# ---- Optional ----
# Vercel Blob (for image uploads later)
# BLOB_READ_WRITE_TOKEN="vercel_blob_..."

# Cron secret for scheduled reminders (later phase)
# CRON_SECRET="another-random-secret"
